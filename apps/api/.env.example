# Copy to .env. Never commit the real .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set to true behind a reverse proxy (Caddy/Nginx) so client IPs are read correctly.
TRUST_PROXY=false

# ---- Database ----
# Leave empty in development to use the embedded PGlite database in .data/pglite.
# Production must use real Postgres:
# DATABASE_URL=postgres://yourwifi:password@localhost:5432/yourwifi
DATABASE_URL=

# ---- URLs ----
PUBLIC_PORTAL_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Serve the built portal (/) and admin (/admin) from this API process.
SERVE_STATIC=false

# ---- Payments ----
# mock = simulated checkout for local dev. paystack = real Paystack (test or live keys).
PAYMENT_DRIVER=mock
# Test key from https://dashboard.paystack.com/#/settings/developers. Live key only in production.
PAYSTACK_SECRET_KEY=
# Paystack requires an email. Only older accounts without one get <phone>@this-domain.
PLACEHOLDER_EMAIL_DOMAIN=customers.yourwifi.ng

# ---- Sign-in ----
# Signs both admin and customer sign-in cookies (each kind is only accepted by its own side).
# Changing it signs everyone out. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# ---- Email (password reset links) ----
# mock = log emails to the console instead of sending (dev only). smtp = send through SMTP_URL.
MAIL_DRIVER=mock
# Any SMTP provider works (Brevo, Resend, Amazon SES, Zoho, ...). Use smtps:// for port 465.
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=YourWiFi <no-reply@yourwifi.ng>

# ---- Background jobs ----
# How often pending payments are re-checked with Paystack, in case a webhook never arrived.
RECONCILE_INTERVAL_SECONDS=120

# ---- Voucher generation ----
# Day of the month (1-28, Lagos time) when new codes are generated for plans with a stock target.
VOUCHER_GENERATION_DAY=1
# Lets the router collect generated batches itself (see infra/mikrotik/). Leave empty to download
# batches from the admin dashboard instead. At least 32 random characters.
ROUTER_TOKEN=
