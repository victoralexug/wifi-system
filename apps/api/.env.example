# Copy to .env. Never commit the real .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set to true behind a reverse proxy (Caddy/Nginx) so client IPs are read correctly.
TRUST_PROXY=false

# ---- Database ----
# Leave empty in development to use the embedded PGlite database in .data/pglite.
# Production must use real Postgres:
# DATABASE_URL=postgres://yourwifi:password@localhost:5432/yourwifi
DATABASE_URL=

# ---- URLs ----
PUBLIC_PORTAL_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Serve the built portal (/) and admin (/admin) from this API process.
SERVE_STATIC=false

# ---- Payments ----
# mock = simulated checkout for local dev. paystack = real Paystack (test or live keys).
PAYMENT_DRIVER=mock
# Test key from https://dashboard.paystack.com/#/settings/developers. Live key only in production.
PAYSTACK_SECRET_KEY=
# Paystack requires an email; customers who skip it get <phone>@this-domain.
PLACEHOLDER_EMAIL_DOMAIN=customers.yourwifi.ng

# ---- Network controller ----
# mock = simulated router. mikrotik = RouterOS v7 REST API.
NETWORK_DRIVER=mock
NETWORK_DEVICE_NAME=primary
# Router's address over the WireGuard tunnel (see infra/README.md).
MIKROTIK_URL=https://10.8.0.2
MIKROTIK_USER=yourwifi-api
MIKROTIK_PASSWORD=
# true only when the REST API is reached through the private tunnel with a self-signed cert.
MIKROTIK_INSECURE_TLS=true
MIKROTIK_HOTSPOT_SERVER=hotspot1

# ---- Sign-in ----
# Signs both admin and customer sign-in cookies (each kind is only accepted by its own side).
# Changing it signs everyone out. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# ---- Background jobs ----
JOB_INTERVAL_SECONDS=30
HEALTH_INTERVAL_SECONDS=60
MAX_PROVISION_ATTEMPTS=40
